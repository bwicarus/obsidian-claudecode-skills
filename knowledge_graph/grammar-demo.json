    {
      "id": "gr.l2.clause-relative-which-that",
      "level": 2,
      "parent_id": "gr.l0.ch2",
      "name": "定语从句 which / that",
      "chapter_label": "第 2 类",
      "numeric_label": "2.1",
      "pages": [],
      "summary": "用 which / that 引导修饰先行词的从句。限定性从句用 that 或 which；非限定（带逗号）只能用 which。先行词指物时这两个常互换。",
      "keywords": [
        "which",
        "that",
        ","
      ],
      "note_ref": "",
      "containing_notes": [],
      "mastery": 0.0,
      "state": "unlockable",
      "unlocked": true,
      "mastered": false,
      "tracked": false
    },
    {
      "id": "gr.l2.clause-relative-who-whom",
      "level": 2,
      "parent_id": "gr.l0.ch2",
      "name": "定语从句 who / whom",
      "chapter_label": "第 2 类",
      "numeric_label": "2.2",
      "pages": [],
      "summary": "who 引导指人定语从句作主语；whom 作宾语（口语 who 也常作宾）。所有格用 whose。",
      "keywords": [
        "who",
        "whom",
        "whose"
      ],
