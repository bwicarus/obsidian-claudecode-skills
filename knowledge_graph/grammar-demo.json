    {
      "id": "gr.l2.clause-conditional-if",
      "level": 2,
      "parent_id": "gr.l0.ch2",
      "name": "条件句 if (Type 1/2/3)",
      "chapter_label": "第 2 类",
      "numeric_label": "2.5",
      "pages": [],
      "summary": "Type 1（真实可能）：If + 一般现在, will + 原形。Type 2（与现在事实相反）：If + 一般过去, would + 原形。Type 3（与过去相反）：If + 过去完成, would have + 过去分词。",
      "keywords": [
        "if",
        "unless",
        "would",
        "had"
      ],
      "note_ref": "",
      "containing_notes": [],
      "mastery": 0.0,
