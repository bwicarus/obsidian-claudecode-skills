    {
      "id": "gr.l2.tense-past-simple",
      "level": 2,
      "parent_id": "gr.l0.ch1",
      "name": "一般过去时 (Past Simple)",
      "chapter_label": "第 1 类",
      "numeric_label": "1.1",
      "pages": [],
      "summary": "动词过去式表示过去某时间发生且已结束的动作或状态。规则动词 +ed；不规则动词需记忆。常配时间状语：yesterday / last week / in 2020 / ago。",
      "keywords": [
        "过去",
        "did",
        "was",
        "were",
        "yesterday",
        "ago"
      ],
      "note_ref": "",
      "containing_notes": [],
      "mastery": 0.0,
      "state": "unlockable",
      "unlocked": true,
      "mastered": false,
      "tracked": false
    },
    {
      "id": "gr.l2.tense-past-perfect",
      "level": 2,
      "parent_id": "gr.l0.ch1",
      "name": "过去完成时 (Past Perfect)",
      "chapter_label": "第 1 类",
      "numeric_label": "1.2",
      "pages": [],
      "summary": "had + 过去分词。表示过去某时间或动作之前已完成的动作（'过去的过去'）。常跟一般过去时对比使用：先发生的用过去完成，后发生的用一般过去。",
      "keywords": [
        "had",
        "before",
        "after",
        "by the time",
        "already"
      ],
      "note_ref": "",
      "containing_notes": [],
      "mastery": 0.0,
      "state": "unlockable",
      "unlocked": true,
      "mastered": false,
      "tracked": false
    },
    {
      "id": "gr.l2.tense-present-perfect",
      "level": 2,
      "parent_id": "gr.l0.ch1",
      "name": "现在完成时 (Present Perfect)",
      "chapter_label": "第 1 类",
      "numeric_label": "1.3",
      "pages": [],
      "summary": "have/has + 过去分词。表示过去发生但跟现在有联系的动作（已完成 / 经验 / 持续到现在）。注意跟一般过去时区别：完成时不指明具体过去时间。",
      "keywords": [
        "have",
        "has",
        "since",
        "for",
        "ever",
        "never",
        "already",
        "yet"
      ],
      "note_ref": "",
      "containing_notes": [],
      "mastery": 0.0,
      "state": "unlockable",
      "unlocked": true,
      "mastered": false,
      "tracked": false
    },
    {
