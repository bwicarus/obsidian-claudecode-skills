[Unit]
Description=Doubao realtime S2S voice relay (browser ws <-> openspeech binary protocol)
After=network.target

[Service]
Type=simple
User=bwicarus
WorkingDirectory=/home/bwicarus/webapp
ExecStart=/home/bwicarus/mcp-venv/bin/python /home/bwicarus/webapp/voice_realtime_relay.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
