[Unit]
Description=iPad 截图问答 daemon + cmd_server (服务器侧)
After=anki-headless.service network-online.target
Wants=anki-headless.service

[Service]
Type=simple
EnvironmentFile=/root/claude/.env
Environment=BWICARUS_APP_DIR=/root/claude/state/qa-server-data
WorkingDirectory=/root/claude
# qa_browser 模板默认引 jsdelivr CDN，iPad 网络可能慢/不通。
# 每次启动重新 patch 成本机 nginx 服务的副本（git pull 覆盖原文件也无影响）。
# 副本位置: /var/www/html/static/qa/{mathjax,marked}.js
ExecStartPre=/bin/sed -i "s|https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js|https://bwicarus.space/static/qa/mathjax.js|g" /root/claude/_client/core/qa_browser.py
ExecStartPre=/bin/sed -i "s|https://cdn.jsdelivr.net/npm/marked@9/marked.min.js|https://bwicarus.space/static/qa/marked.js|g" /root/claude/_client/core/qa_browser.py
# Claude CLI 拒绝 root 用 --dangerously-skip-permissions（"cannot be used with root/sudo"），
# 直接替换成 --allowedTools Read（让它能读注入的图片但其它工具走默认询问/拒绝）。
# 单次替换保证幂等：替换后字串里没有 --dangerously-skip-permissions，sed 再跑也是 no-op。
ExecStartPre=/bin/sed -i 's|"--dangerously-skip-permissions"|"--allowedTools", "Read"|g' /root/claude/_client/core/ai_backends.py
ExecStart=/usr/bin/python3 /root/claude/_server_deploy/qa_server.py
Restart=on-failure
RestartSec=10
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
