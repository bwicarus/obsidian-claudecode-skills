[Unit]
Description=Obsidian Sync daemon (obsidian-headless ob sync --continuous)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/home/bwicarus/claude/.env
WorkingDirectory=/home/bwicarus/obsidian
ExecStart=/usr/bin/ob sync --path /home/bwicarus/obsidian --continuous
Restart=on-failure
RestartSec=30
User=bwicarus

[Install]
WantedBy=multi-user.target
