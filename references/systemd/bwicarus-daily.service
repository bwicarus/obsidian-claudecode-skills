[Unit]
Description=Daily Anki/Vault automation (Pi)
After=anki-headless.service obsidian-sync.service network-online.target
Wants=anki-headless.service obsidian-sync.service

[Service]
Type=oneshot
EnvironmentFile=/home/bwicarus/claude/.env
WorkingDirectory=/home/bwicarus/claude
ExecStart=/usr/bin/python3 /home/bwicarus/claude/scripts/daily_anki_status.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=7200
User=bwicarus

[Install]
WantedBy=multi-user.target
