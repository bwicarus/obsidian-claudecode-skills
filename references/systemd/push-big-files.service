[Unit]
Description=Push >200MB vault files to PC (Obsidian Sync 200MB/file limit bypass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/home/bwicarus/claude/.env
WorkingDirectory=/home/bwicarus/claude
ExecStart=/usr/bin/python3 /home/bwicarus/claude/scripts/push_big_files_to_pc.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600
User=bwicarus

[Install]
WantedBy=multi-user.target
