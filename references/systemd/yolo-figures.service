[Unit]
Description=DocLayout-YOLO figure detection (idle batch over enabled books)
After=network.target
# fail-loop 保护:5 分钟内 fail 3 次就停
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=bwicarus
Group=bwicarus
WorkingDirectory=/home/bwicarus/claude
Environment="CLAUDE_PROJECT=/home/bwicarus/claude"
Environment="OBSIDIAN_VAULT=/home/bwicarus/obsidian"
Environment="HOME=/home/bwicarus"

# 闲时低优先级:YOLO 在 Pi CPU ~6.7s/页,让 webapp/AI/SSH 优先,它捡空跑
Nice=19
CPUWeight=20
IOWeight=10

# --all:扫所有开了「插图描述」的书的 sidecar,跑 YOLO 写 figures_geom(幂等,已处理的跳过)
ExecStart=/home/bwicarus/doclayout-venv/bin/python /home/bwicarus/claude/scripts/yolo_figures.py --all

Restart=on-failure
RestartSec=120
RemainAfterExit=no

StandardOutput=append:/home/bwicarus/claude/state/logs/yolo-figures.log
StandardError=append:/home/bwicarus/claude/state/logs/yolo-figures.log
