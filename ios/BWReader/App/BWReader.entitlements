<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 读健康库里的睡眠分段(2026-09-08):复习提醒的"起床点"用真实醒来时刻,
         比"他开始碰这套系统了"准。只读不写;不声明 healthkit.background-delivery,
         等基础链路稳了再加,那时不用再动开发者后台。 -->
    <key>com.apple.developer.healthkit</key>
    <true/>
    <!-- 后台投递（2026-09-09 用户点名要）：让系统在新的睡眠样本落库时把 App
         叫醒，不必等用户打开它。上面那条注释当时写"等基础链路稳了再加，
         那时不用再动开发者后台" —— 链路 2026-09-08 已端到端验过，现在补上。
         ⚠ 它不需要 UIBackgroundModes：HealthKit 用的是自己那套唤醒，
         不是后台模式。加了反而会被审核问"你要后台干什么"。 -->
    <key>com.apple.developer.healthkit.background-delivery</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.space.bwicarus.bwreader2</string>
    </array>
    <!-- VoIP 来电推送（2026-08-29）。用户在开发者后台把这把 APNs 密钥
         配成 **Production** —— TestFlight 装的 App 走的正是 production
         环境，选 Sandbox 的话推送永远到不了设备，而那个选项不可更改。 -->
    <key>aps-environment</key>
    <string>production</string>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)space.bwicarus.bwreader2.realtime</string>
    </array>
</dict>
</plist>
