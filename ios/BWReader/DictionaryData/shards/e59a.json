ji"],"zhSenses":[{"examples":[],"glosses":["囊的擴張新字體"],"pos":"char"},{"examples":[{"ja":"その女の子はお菓子の袋に手を突っ込んでいた","source":"wty","zh":"那個女孩一直往糖果袋裡拿糖果"},{"ja":"私たちで1袋のクッキーを分けた","source":"wty","zh":"餅乾被分裝到我們的袋子裡"}],"glosses":["袋子"],"pos":"n"},{"examples":[],"glosses":["一瓣果肉，像是橘子"],"pos":"n"},{"examples":[],"glosses":["形狀像袋子的器官"],"pos":"n"},{"examples":[],"glosses":["袋alternative kanji"],"pos":"non-lemma"}]},{"common":false,"forms":["かかあ天下","カカア天下","嚊天下","嬶天下","カカァ天下","かかあ殿下"],"glosses":["household with the wife as the boss","wife wearing the pants","wife ruling the roost","house with a henpecked husband"],"id":"1566190","lemma":"かかあ天下","pos":["n"],"readings":["かかあでんか"]},{"accent":4,"common":true,"etymology":[],"examples":[{"en":"It is only through knowledge that we, as a nation, can cope with the dangers that threaten our society.","ja":"知識を通じてのみ、われわれは、一つの民族として、われわれの社会を脅かす危険に対処することができるからである。","ref":"277051_127039","source":"tanaka"},{"en":"Air pollution will be a threat to our survival.","ja":"大気汚染は我々の生存を脅かすものになるだろう。","ref":"275656_137580","source":"tanaka"},{"en":"Solar energy does not threaten the environment.","ja":"太陽エネルギーは環境を脅かさない。","ref":"2755127_138205","source":"tanaka"},{"en":"Atomic bombs are a danger to the human race.","ja":"原子爆弾は人類をおびやかすものだ。","ref":"239464_175003","source":"tanaka"},{"en":"Don't scare me like that!","ja":"脅かさないでよ。","ref":"18944_180084","source":"tanaka"}],"forms":["脅かす","嚇かす","威かす"],"glosses":["to threaten","to menace","to intimidate","to startle","to frighten","to scare"],"id":"1578070","lemma":"脅かす","pos":["v5s","vt"],"readingKata":"オビヤカス","readings":["おどかす"],"sourceUrls":["https://zh.wiktionary.org/wiki/おどかす#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/お/おど/おどかす.html"],"synonyms":[],"zhGlosses":["见脅かす。"],"zhSenses":[{"examples":[],"glosses":["见脅かす。"],"pos":""}]},{"accent":0,"common":false,"forms":["赫々","赫赫","嚇嚇","嚇々"],"glosses":["brilliant","bright","glorious"],"id":"1590000","lemma":"赫々","pos":["adj-t","a