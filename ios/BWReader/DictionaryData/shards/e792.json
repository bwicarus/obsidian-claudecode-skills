t":1,"common":true,"examples":[{"en":"He's handsome and nice, but he has no class.","ja":"彼はハンサムですてきなのだけど上品とはいえないわ。","ref":"292457_111227","source":"tanaka"},{"en":"Mrs. Smith, I'd like to introduce a friend of mine, Pierre Dubois.","ja":"スミスさん、ピエール・デュボワをご紹介しますわ。私の親友なの。","ref":"51607_11212004","source":"tanaka"},{"en":"I am happy to hear your voice.","ja":"あなたの声が聞けてうれしいわ。","ref":"70500_1142225","source":"tanaka"},{"en":"A ring of smoke floated from his cigar into the air.","ja":"彼の葉巻から煙の輪が空中に漂っていた。","ref":"287753_115916","source":"tanaka"},{"en":"There are only five minutes till the train starts, and she hasn't appeared.","ja":"発車まであと５分しかないのに、彼女は姿を見せないわ。","ref":"282691_121315","source":"tanaka"}],"forms":["輪","環"],"glosses":["ring","circle","loop","hoop","wheel","circle (e.g. of friends)","planetary ring"],"id":"1555710","lemma":"輪","pos":["n"],"readingKata":"ワ","readings":["わ"]},{"common":false,"etymology":[],"examples":[],"forms":["環状線"],"glosses":["loop line","(transportation) belt line"],"id":"1651270","lemma":"環状線","pos":["n"],"readings":["かんじょうせん"],"sourceUrls":["https://zh.wiktionary.org/wiki/環状線#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/環/環状/環状線.html"],"synonyms":[],"zhGlosses":["环形线路。"],"zhSenses":[{"examples":[],"glosses":["环形线路。"],"pos":"n"}]},{"accent":0,"common":false,"forms":["環海"],"glosses":["surrounding seas","surrounded by the sea"],"id":"1651280","lemma":"環海","pos":["n"],"readingKata":"カンカイ","readings":["かんかい"]},{"common":false,"forms":["環太平洋"],"glosses":["Pacific Rim"],"id":"1665960","lemma":"環太平洋","pos":["n"],"readings":["かんたいへいよう"]},{"common":false,"forms":["環太平洋火山帯"],"glosses":["circum-Pacific volcanic belt","Ring of Fire"],"id":"1665970","lemma":"環太平洋火山帯","pos":["n"],"readings":["かんたいへいようかざんたい"]},{"common":false,"forms":["環太平洋造山帯"],"glosses":["circum-Pacific orogeny"],"id":"1665990","lemma":"環太平洋造山帯","pos":["n"],"readings":["かんたいへいようぞうざんたい"]},{"common":false,"forms":["環太平洋構想"],"glosses":["Pan-Pacific concept