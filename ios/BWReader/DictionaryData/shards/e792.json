":true,"examples":[{"en":"He made an admirable speech about protecting the environment.","ja":"彼は環境保護についてりっぱな演説をした。","ref":"294929_108761","source":"tanaka"},{"en":"I would like to put special emphasis on the concept that social ecology is the second school of contemporary environmentalism.","ja":"社会エコロジーが現代の環境保護の第２の流れであるという観点を特に強調しておきたい。","ref":"265329_149229","source":"tanaka"},{"en":"I interviewed a lady who works to protect the environment.","ja":"私は環境保護の仕事をしている女性にインタビューをしました。","ref":"256718_157813","source":"tanaka"},{"en":"Greenpeace is fighting an uphill battle to save the environment.","ja":"グリーンピースは環境保護のために困難な戦いをしています。","ref":"62854_225518","source":"tanaka"}],"forms":["環境保護"],"glosses":["environmental protection"],"id":"1666040","lemma":"環境保護","pos":["n","adj-no"],"readings":["かんきょうほご"]},{"common":false,"forms":["環境保護主義"],"glosses":["environmentalism"],"id":"1666050","lemma":"環境保護主義","pos":["n"],"readings":["かんきょうほごしゅぎ"]},{"common":false,"forms":["環境保護主義者"],"glosses":["environmentalist"],"id":"1666060","lemma":"環境保護主義者","pos":["n"],"readings":["かんきょうほごしゅぎしゃ"]},{"common":false,"examples":[{"en":"The destruction of the environment is appalling.","ja":"環境破壊は驚くほどすすんでいる。","ref":"21015_183890","source":"tanaka"},{"en":"Industrialization of the region must be carried out very carefully to avoid environmental destruction.","ja":"その地域の工業化は環境破壊を避けるため慎重に進められなければならない。","ref":"45146_207890","source":"tanaka"}],"forms":["環境破壊"],"glosses":["environmental destruction"],"id":"1666070","lemma":"環境破壊","pos":["n"],"readings":["かんきょうはかい"]},{"common":false,"forms":["粗玉","荒玉","新玉","璞"],"glosses":["unpolished and uncut gem"],"id":"1749720","lemma":"粗玉","pos":["n"],"readings":["あらたま"]},{"common":false,"etymology":[],"examples":[],"forms":["環化"],"glosses":["cyclization","cyclisation"],"id":"1867260","lemma":"環化","pos":["n","vs"],"readings":["かんか"],"sourceUrls":["https://zh.wiktionary.org/wiki/環化#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/環/環化/環化.h