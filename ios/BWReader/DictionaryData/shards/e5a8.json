ource":"wty","zh":"他有能力，但有个坏毛病就是爱摆架子。"},{"en":"He is haughty to his juniors.","ja":"彼は下のものにいばっている。","ref":"294216_109473","source":"tanaka"},{"en":"Hero as he was, he was not boastful.","ja":"彼は英雄だったが、威張ってなかった。","ref":"294076_109614","source":"tanaka"},{"en":"Who said you can swagger around like that just because you're one year ahead of me?","ja":"一年先輩だからって、そんなに威張らなくていいじゃない。","ref":"27386_190228","source":"tanaka"},{"en":"As he's just up on his high horse again.","ja":"どうせまたふんぞり返って威張っているだけなのだから。","ref":"38600_201390","source":"tanaka"}],"forms":["威張る","意張る"],"glosses":["to put on airs","to throw one's weight about","to swagger","to act arrogantly"],"id":"1156320","lemma":"威張る","pos":["v5r","vi"],"readingKata":"イバル","readings":["いばる","えばる"],"sourceUrls":["https://zh.wiktionary.org/wiki/威張る#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/威/威張/威張る.html"],"synonyms":[],"zhGlosses":["自吹自擂，摆架子，自以为是"],"zhSenses":[{"examples":[{"ja":"あの人は能力はあるが、威張るのが悪いくせだ","source":"wty","zh":"他有能力，但有个坏毛病就是爱摆架子。"}],"glosses":["自吹自擂，摆架子，自以为是"],"pos":"v godan vi"}]},{"accent":0,"common":false,"forms":["威徳"],"glosses":["virtue and influence","virtue and authority"],"id":"1156330","lemma":"威徳","pos":["n"],"readingKata":"イトク","readings":["いとく"]},{"accent":1,"common":false,"etymology":[],"examples":[{"ja":"威武を示す","source":"wty","zh":"展示自己的權威和軍事實力"}],"forms":["威武"],"glosses":["authority and force"],"id":"1156340","lemma":"威武","pos":["n"],"readingKata":"イブ","readings":["いぶ"],"sourceUrls":["https://zh.wiktionary.org/wiki/威武#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/威/威武/威武.html"],"synonyms":[],"zhGlosses":["威權和軍事力量"],"zhSenses":[{"examples":[{"ja":"威武を示す","source":"wty","zh":"展示自己的權威和軍事實力"}],"glosses":["威權和軍事力量"],"pos":"n"}]},{"accent":1,"common":false,"etymology":[],"examples":[],"forms":["威風"],"glosses":["majesty","dignity"],"id":"1156350","lemma":"威風","pos":["n"],"readingKata":"イフウ","readings":["いふう"],"sourceUrls":["https://zh.wik