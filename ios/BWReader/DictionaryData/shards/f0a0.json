ead person","departed soul","merciful person"],"id":"1501760","lemma":"仏","pos":["n"],"readingKata":"フツ","readings":["ほとけ","ホトケ"],"sourceUrls":["https://zh.wiktionary.org/wiki/佛#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/佛/佛/佛.html","https://zh.wiktionary.org/wiki/仏#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/仏/仏/仏.html"],"synonyms":["仏法","釈迦如来","釈迦牟尼"],"zhGlosses":["（以下詞條尚未創建：仏。）","ૐ佛祖","ૐ佛像","亡靈","col父母對子女親暱的稱呼，等同親愛的","🛐佛教","ૐ超度","ૐ釋迦牟尼","ૐ其他佛經中的菩薩","佛陀","仏redirected from 佛","仏alternative kanji"],"zhSenses":[{"examples":[],"glosses":["（以下詞條尚未創建：仏。）"],"pos":""},{"examples":[],"glosses":["ૐ佛祖"],"pos":"n"},{"examples":[],"glosses":["ૐ佛像"],"pos":"n"},{"examples":[],"glosses":["亡靈"],"pos":"n"},{"examples":[{"ja":"我子の佛、變化の人と申しながら、こゝら大さまで養ひ奉る志疎かならず。","ref":"公元890年，《竹取物語》 (第7頁)","source":"wty","zh":"我親愛的孩子，雖然妳是下凡來的人，但不諱言，我才是提拔和養大妳的人。"},{"ja":"あが仏、何事思ひたまふぞ。","ref":"公元890年，《竹取物語》 (第61頁)","source":"wty","zh":"親愛的，你在想些什麼？"}],"glosses":["col父母對子女親暱的稱呼，等同親愛的"],"pos":"n"},{"examples":[],"glosses":["🛐佛教"],"pos":"n"},{"examples":[],"glosses":["ૐ超度"],"pos":"n"},{"examples":[],"glosses":["ૐ釋迦牟尼"],"pos":"name"},{"examples":[],"glosses":["ૐ其他佛經中的菩薩"],"pos":"name"},{"examples":[],"glosses":["佛陀"],"pos":"char"},{"examples":[],"glosses":["仏redirected from 佛"],"pos":"non-lemma"},{"examples":[],"glosses":["仏alternative kanji"],"pos":"non-lemma"}]},{"accent":0,"common":false,"forms":["叱正","𠮟正"],"glosses":["pointing out errors","correction","critique"],"id":"1647280","lemma":"叱正","pos":["n"],"readingKata":"シッセイ","readings":["しっせい"]},{"common":false,"forms":["叱咤激励","𠮟咤激励","叱咜激励","𠮟咜激励"],"glosses":["giving a loud pep talk","encouraging (someone) strongly in a loud voice"],"id":"2031220","lemma":"叱咤激励","pos":["n","vs"],"readings":["しったげきれい"]},{"common":false,"forms":["叱","𠮟"],"glosses":["shh!","sh!","shush!","shoo!","go away!"],"id":"2395940","lemma":"叱","pos":["int"],"readings":["しっ"]},{"accent":0,"common":false,"etymology":[