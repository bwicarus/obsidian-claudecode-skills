{"contract":"bw-jmdict-shard/3","entries":[{"accent":1,"common":false,"etymology":[],"examples":[{"en":"Black hens lay white eggs.","ja":"鳶が鷹を生む。","ref":"280729_123269","source":"tanaka"}],"forms":["鳶","鴟","鵄"],"glosses":["black kite (Milvus migrans)","construction worker","scaffold erector","firefighter","fire hook","reddish brown","Inverness cape","filcher","sneak thief","pilferer"],"id":"1008670","lemma":"鳶","pos":["n"],"readingKata":"トビ","readings":["とび","とんび","トビ","トンビ"],"sourceUrls":["https://zh.wiktionary.org/wiki/鳶#Japanese","https://kaikki.org/zhwiktionary/All%20languages%20combined/meaning/鳶/鳶/鳶.html"],"synonyms":[],"zhGlosses":["鳥名"],"zhSenses":[{"examples":[],"glosses":["鳥名"],"pos":"char"}]},{"common":false,"forms":["阿片窟","アヘン窟","鴉片窟"],"glosses":["opium den"],"id":"1150060","lemma":"阿片窟","pos":["n"],"readings":["あへんくつ"]},{"accent":1,"common":true,"etymology":[],"examples":[{"en":"Two crows are flying in the sky.","ja":"二羽のからすが空を飛んでいます。","ref":"280845_123155","source":"tanaka"},{"en":"Crows like Tokyo because it is warmer in the city than in the suburbs, and it's bright at night.","ja":"都会は郊外よりも暖かく、夜でも明るくて物をしっかりと見ていられるので、カラスは東京を好む。","ref":"279435_124559","source":"tanaka"},{"en":"Lately, we see crows everywhere.","ja":"最近、あらゆる所でカラスを見かける。","ref":"243727_170753","source":"tanaka"},{"en":"The bird on the roof is a crow.","ja":"屋根の上にいる鳥はからすです。","ref":"25582_188439","source":"tanaka"},{"en":"A crow is as black as coal.","ja":"烏は石炭のように黒い。","ref":"27010_189855","source":"tanaka"}],"forms":["烏","鴉"],"glosses":["crow (Corvus spp.)","raven"],"id":"1171450","lemma":"烏","pos":["n"],"readingKata":"カラス","readings":["カラス","からす"],"sourceUrls":[],"synonyms":[],"zhGlosses":["からすalternative kanji"],"zhSenses":[{"examples":[],"glosses":["からすalternative kanji"],"pos":"non-lemma"}]},{"common":false,"forms":["鴉の濡れ羽色","からすの濡れ羽色","烏の濡れ羽色"],"glosses":["glossy black (hair)","color of a crow with wet feathers"],"id":"1171470","lemma":"鴉の濡れ羽色","pos":["exp","n"],"readings":["からすのぬればいろ