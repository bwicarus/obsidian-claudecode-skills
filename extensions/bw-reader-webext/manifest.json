{
  "manifest_version": 3,
  "name": "BW 网页伴读",
  "version": "0.1.0",
  "description": "在真实网页中提供查词、翻译、解释和学习功能（Safari/Chromium WebExtension）。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bwicarus.taile44d0c.ts.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://bwicarus.taile44d0c.ts.net/*",
        "https://bwicarus.space/*"
      ],
      "js": [
        "src/facade.js",
        "vendor/mathjax-full.js",
        "vendor/marked.js",
        "vendor/rc-core.js",
        "vendor/rc-md.js",
        "vendor/rc-toolchip.js",
        "vendor/rc-turncard.js",
        "vendor/rc-voicecall.js",
        "vendor/rc-result.js",
        "vendor/rc-wordpop.js",
        "vendor/rc-phrasepop.js",
        "vendor/rc-sidedrawer.js",
        "vendor/rc-assistant.js",
        "src/web-adapter.js",
        "src/shell.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_title": "BW 网页伴读",
    "default_popup": "popup.html"
  },
  "icons": {
    "512": "icons/icon-512.png"
  }
}
