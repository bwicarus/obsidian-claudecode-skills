# Python 缓存
__pycache__/
*.pyc
*.pyo

# Claude Code 本地配置（机器特定，不提交）
.claude/settings.local.json
.claude/settings.json
.claude/worktrees/

# PyInstaller 构建产物
_client/build/
_client/dist/
launchers/build/
launchers/dist/
*.spec.bak

# 运行时状态、日志、备份、临时文件
state/
temp/

# Python 虚拟环境
.venv/
venv/
env/

# 环境变量（机器特定路径 + 不应入仓的配置）
.env
.env.local
knowledge_graph/
state/kg/

# Google Cloud Vision API key (绝对不入 git,用环境变量传)
*gcp-vision-key*
*google-vision-key*
.config/gcp-vision-key


# 大体积词典/语料二进制(可由脚本重建,不入库)
data/
state/mcp-headless.json

# 浏览器扩展测试渠道发布生成物（源码在 extensions/bw-reader-webext/）
extensions/bw-reader-webext-*-windows-test.zip
extensions/bw-reader-webext-*-safari-ios.zip
extensions/bw-reader-webext-test-channel*.zip
extensions/bw-reader-webext-test-channel.json
extensions/bw-reader-extension-test.ps1
extensions/bw-reader-extension-test-v*.ps1

# Windows 电脑语音直连桥接器：仅本机候选打包输出，绝不包含运行时配置或配对状态
extensions/bw-reader-webext/windows/candidates/

# Windows 本地实例(run_local.ps1)的运行时数据:账号库 app.db、各类 .log/.err/.out
webapp-data/

# PDF.js vendor(第三方库,不入库):生产上同样在 git 之外,直接放 /var/www/html/static/pdfjs
_server_deploy/static/pdfjs/
